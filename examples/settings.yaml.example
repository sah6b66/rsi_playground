# ════════ 网络Agent RSI演练场 — 用户配置 ════════
# 本文件仅包含使用者可修改的配置项（用户级 ~40 键）。
# 部署级环境变量（RSI_JWT_SECRET / RSI_MASTER_KEY / RSI_HOME）见 INSTALL.md。
# 开发运维内部项见 settings-internal.yaml.example（通常无需修改）。
#
# 使用方法：
#   1. 复制此文件为 settings.yaml 放到 RSI_HOME 目录（默认 ./var）
#   2. 按注释逐项修改，未修改的项使用默认值
#   3. 环境变量可覆盖（前缀 RSI_，如 RSI_SERVER__PORT=9000）
#   4. 未列出的键均由专用页面管理（网络仿真平台 / 载体主机）或属内部项

# ── 服务 ──
server:
  host: 0.0.0.0                 # API 监听地址；0.0.0.0=全部接口，127.0.0.1=仅本机
  port: 8000                    # API 端口号；1-65535；默认 8000

# ── 数据库 ──
database:
  url: sqlite:///var/platform.db
  # P0 用 SQLite（无需安装数据库）；P1 升级 PostgreSQL 时改：
  # url: postgresql://user:pass@localhost:5432/rsi_playground

# ── 模型服务（LLM）──
llm:
  providers:
    anthropic:
      api_key: ""               # 直接填入密钥（内网可信环境，明文保存）
      base_url: ""              # 留空使用官方地址
    openai_compat:
      api_key: ""
      base_url: ""              # 兼容网关（如 vLLM / one-api）地址
  defaults:
    judge:
      model: ""                 # 裁判模型名称；留空用回放/规则兜底
      temperature: 0.0          # 采样温度；0 = 尽量确定性
  cassette_mode: replay         # replay 回放录像 / record 录制 / off 真实调用
  max_concurrent_calls: 4       # 模型并发调用上限

# ── 裁判 ──
judge:
  det_timeout_s: 120            # 确定性（规则型）评审单次执行超时（秒）
  llm_retry: 2                  # 模型评审失败重试次数
  pairwise_enabled: true        # 同轮多方案时启用两两对比评审

# ── 优化与决策 ──
optimizer:
  critic_max_repair_rounds: 5   # 自动评审发现问题后的最大修复轮数
  sft:
    no_gain_rounds: 5           # 连续无提升多少轮后允许整理 SFT 训练数据
    min_samples: 50             # 整理训练数据所需最低有效样本数
decision:
  alpha: 0.05                   # 统计检验显著性水平 α；越小越保守
  no_gain_rounds_default: 5     # 连续无提升多少轮后触发收敛判定
  noise:
    k_repeats: 3                # 标定基线噪声的重复测量次数
    factor: 1.96                # 95% 置信对应的 σ 倍数

# ── 编排 ──
orchestrator:
  max_parallel_batches: 2       # 同时运行的评测批次数上限
  checkpoint_interval_s: 5      # 断点续跑检查点存档间隔（秒）
  health_monitor_interval_s: 30 # 运行环境健康巡检周期（秒）
  budget:
    iteration_default:          # 每个 RSI 会话的缺省预算
      max_tokens: 50000000      # Token 上限
      max_wall_hours: 8         # 墙上时长上限（小时）
      max_cost_usd: 200         # 费用上限（美元）
    global:                     # 全平台累计预算（yaml 键 global，代码字段 global_）
      max_tokens: 100000000
      max_wall_hours: 0         # 0 = 不限制
      max_cost_usd: 400

# ── 载体缺省 ──
carrier:
  task_timeout_s: 1800          # Agent 单任务最长执行时间（秒）；可热更
  max_instances_per_host: 10    # 未单独配置主机的实例数上限；可热更
  # 载体主机（carrier.hosts.*）由「网络Agent」页面管理，不入本文件

# ── 网络仿真缺省 ──
sandbox:
  build_retry: 2                # 实验环境构建失败重试次数
  ready_timeout_s: 600          # 等待仿真环境就绪超时（秒）
  # 仿真平台实例（sandbox.backends.*）由「网络仿真」页面管理，不入本文件

# ── 轨迹 ──
tracing:
  redact:
    enabled: true               # 入库前按规则抹除密钥等敏感内容
  archive:
    hot_days: 90                # 热数据保留天数；超期转入冷归档

# ── 日志 ──
logging:
  level: info                   # debug / info / warning / error；可热更
  retention_days: 30            # 超期日志自动清理
  error_split: true             # 错误级别日志单独落盘便于排查

# ── 可复现 ──
seed:
  master: 20261102              # 随机种子：相同种子+相同输入 → 相同采样与裁决顺序
